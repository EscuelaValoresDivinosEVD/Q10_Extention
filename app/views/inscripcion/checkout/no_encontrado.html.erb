<% content_for :title, "Curso no encontrado" %>

<div class="inscripcion-page">
  <div class="inscripcion-card inscripcion-empty">
    <div class="inscripcion-result-icon inscripcion-result-icon--error" aria-hidden="true">!</div>
    <h1 class="inscripcion-title">No encontramos el curso que buscas</h1>
    <p class="hint">
      Puede que la inscripción en línea de este curso ya esté cerrada.
      Escríbenos a <%= mail_to "info@clev.org" %> y te ayudamos.
    </p>
  </div>
</div>
