<% content_for :title, "Inscripción — #{@curso[:name]}" %>

<div class="inscripcion-page">
  <div class="inscripcion-card">
    <p class="inscripcion-kicker">Pago de inscripción</p>
    <h1 class="inscripcion-title"><%= @curso[:name] %></h1>

    <ul class="inscripcion-meta">
      <% if @curso[:fecha_inicio].present? %>
        <li>Inicia <%= l(@curso[:fecha_inicio].to_date, format: :short) %></li>
      <% end %>
      <% if @curso[:fecha_fin].present? %>
        <li>Finaliza <%= l(@curso[:fecha_fin].to_date, format: :short) %></li>
      <% end %>
      <% if @con_cupos %>
        <li><%= pluralize(@cupos_disponibles, "cupo disponible", "cupos disponibles") %></li>
      <% end %>
    </ul>

    <% if flash[:alert] %>
      <div class="flash alert" role="alert"><%= flash[:alert] %></div>
    <% end %>

    <% if !@con_cupos %>
      <div class="flash alert" role="status">
        Este curso ya no tiene cupos disponibles.
      </div>
      <p class="hint">Escríbenos a <%= mail_to "info@clev.org" %> para consultar por la próxima edición.</p>

    <% elsif @opciones.empty? %>
      <%# ⛔ Bloqueante conocido: sin fuente de precio definida no hay opciones que ofrecer. %>
      <div class="flash alert" role="status">
        Las opciones de inscripción de este curso todavía no están disponibles.
      </div>
      <p class="hint">Escríbenos a <%= mail_to "info@clev.org" %> y te ayudamos a completar tu inscripción.</p>

    <% else %>
      <%= form_with url: inscripcion_checkout_path, method: :post, local: true,
                    data: { turbo: false }, class: "inscripcion-form" do %>
        <%= hidden_field_tag :codigo, @course_code %>

        <fieldset class="inscripcion-options">
          <legend class="inscripcion-kicker">Elige cómo pagar</legend>
          <% @opciones.each_with_index do |opcion, indice| %>
            <label class="inscripcion-option">
              <input type="radio"
                     name="opcion_code"
                     value="<%= opcion[:option_code] %>"
                     <%= "checked" if @opcion_seleccionada == opcion[:option_code] || (@opcion_seleccionada.blank? && indice.zero?) %>
                     required />
              <span class="inscripcion-option__label"><%= opcion[:option_label] %></span>
              <span class="inscripcion-option__amount">
                <%= number_to_currency(opcion[:amount], unit: "$", precision: 2) %> <%= opcion[:currency] %>
              </span>
            </label>
          <% end %>
        </fieldset>

        <h2 class="inscripcion-kicker">Datos de facturación</h2>

        <div class="field-grid">
          <div class="field">
            <label for="first_name">Nombre *</label>
            <input type="text" name="first_name" id="first_name" value="<%= @billing[:first_name] %>" required />
          </div>
          <div class="field">
            <label for="last_name">Apellido *</label>
            <input type="text" name="last_name" id="last_name" value="<%= @billing[:last_name] %>" required />
          </div>
        </div>

        <div class="field-grid">
          <div class="field">
            <label for="identification_type_code">Tipo de documento *</label>
            <select name="identification_type_code" id="identification_type_code" required>
              <% @tipos_identificacion.each do |tipo| %>
                <option value="<%= tipo[:code] %>"
                        <%= "selected" if @billing[:identification_type_code] == tipo[:code] %>
                        <% if tipo[:pattern].present? %>data-pattern="<%= tipo[:pattern] %>"<% end %>>
                  <%= tipo[:name] %>
                </option>
              <% end %>
            </select>
          </div>
          <div class="field">
            <label for="identification_number">Número de documento *</label>
            <input type="text" name="identification_number" id="identification_number"
                   value="<%= @billing[:identification_number] %>" required />
          </div>
        </div>

        <div class="field-grid">
          <div class="field">
            <label for="email">Correo *</label>
            <input type="email" name="email" id="email" value="<%= @billing[:email] %>" required />
          </div>
          <div class="field">
            <label for="phone">Teléfono *</label>
            <input type="tel" name="phone" id="phone" value="<%= @billing[:phone] %>" required />
          </div>
        </div>

        <div class="field">
          <label for="address">Dirección *</label>
          <input type="text" name="address" id="address" value="<%= @billing[:address] %>" required />
        </div>

        <div class="field-grid">
          <div class="field">
            <label for="city">Ciudad *</label>
            <input type="text" name="city" id="city" value="<%= @billing[:city] %>" required />
          </div>
          <div class="field">
            <label for="country">País *</label>
            <input type="text" name="country" id="country" value="<%= @billing[:country].presence || 'Ecuador' %>" required />
          </div>
        </div>

        <p class="hint">Con estos datos se emite tu factura electrónica. Los cursos no llevan IVA.</p>

        <div class="actions">
          <button type="submit" class="btn btn-primary">Ir a pagar</button>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
